# Parlament reads this on the server side only. Copy to .env.local (git-ignored) and fill in.
# You need at least one key; the AI-modell picker greys out models whose key is missing.

# Mistral (the default model): an API key from console.mistral.ai. The free "Experiment" plan works.
MISTRAL_API_KEY=
# "free" (default): costs show as $0 and requests are paced to about one per second, the free plan's limit.
# "paid": list prices and full parallelism.
MISTRAL_TIER=free
# Optional pacing overrides (milliseconds between request starts, and requests at once):
# MISTRAL_MIN_INTERVAL_MS=1100
# MISTRAL_MAX_CONCURRENT=3

# Claude: an Anthropic Console API key (console.anthropic.com). A Claude.ai subscription will NOT work.
ANTHROPIC_API_KEY=
# Gemini: a Gemini API key from Google AI Studio (aistudio.google.com/apikey).
GEMINI_API_KEY=

# Optional: where the SQLite file lives (default ./data/parlament.db)
# PARLAMENT_DB_PATH=./data/parlament.db
# Optional: folder with the member .md files (default ./members)
# PARLAMENT_MEMBERS_DIR=./members
