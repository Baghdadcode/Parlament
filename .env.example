# Parlament reads this on the server side only. Copy to .env.local (git-ignored) and fill in.
# Needs an Anthropic Console API key (console.anthropic.com). A Claude.ai subscription will NOT work.
ANTHROPIC_API_KEY=
# Optional: where the SQLite file lives (default ./data/parlament.db)
# PARLAMENT_DB_PATH=./data/parlament.db
# Optional: folder with the member .md files (default ./members)
# PARLAMENT_MEMBERS_DIR=./members
